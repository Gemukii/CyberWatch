# ============ Discord ============
# Bot token: developer portal > your application > Bot > Reset Token
DISCORD_TOKEN=paste_your_token_here
# Publishing channel ID (developer mode > right-click the channel > Copy ID)
DISCORD_CHANNEL_ID=123456789012345678
# Optional: server ID. If set, slash commands appear instantly. Otherwise
# sync is global (up to 1h of propagation).
DISCORD_GUILD_ID=

# ============ Scheduling ============
# COLLECTION frequency (free: no AI, no publishing).
INTERVAL_MINUTES=60
MAX_AGE_HOURS=24             # ignore articles older than this
CANDIDATE_TTL_HOURS=36       # lifetime of a candidate in the queue
SHORTLIST_LIMIT=15           # articles pushed through enrichment per collection cycle

# ============ Daily publishing budget ============
# This is where you tune publishing volume.
# Selection is RELATIVE: the bot publishes the top N of the day, not
# whatever clears a fixed bar. To be more selective, lower DAILY_QUOTA —
# don't raise the floor, which only exists to screen out off-topic articles.
DAILY_QUOTA=4                # articles in the daily digest
DIGEST_MIN_ARTICLES=2        # published even on a quiet day (0 = silence allowed)
DIGEST_FLOOR_SCORE=7         # relevance floor, NOT an excellence bar
DIGEST_HOUR=8                # local hour the digest is sent
TIMEZONE=Europe/Paris

# ============ Feedback loop (👍 / 👎 votes) ============
# The bot learns from your reactions on published articles. Weights are
# recomputed from Discord history — nothing is stored on disk.
# Requires the "Add Reactions" permission on the channel.
ENABLE_FEEDBACK=true
FEEDBACK_LOOKBACK_DAYS=30    # sliding window of votes taken into account
FEEDBACK_MIN_VOTES=3         # votes required on a signal before any adjustment
FEEDBACK_MAX_ADJUSTMENT=4    # max adjustment per signal (deliberately capped)
FEEDBACK_TTL_HOURS=6         # how often history is re-read
FEEDBACK_MESSAGE_LIMIT=500

# ============ Urgent alerts (outside the quota, published immediately) ============
ENABLE_URGENT=true
URGENT_EPSS_THRESHOLD=0.7    # 30-day exploitation probability (0-1)
URGENT_SCORE_THRESHOLD=30    # safety net for CVE-less stories
URGENT_DAILY_MAX=2           # anti-flood guard (beyond it, deferred to the digest)
URGENT_MENTION=none          # "none", "here", or a Discord role ID

# ============ Filtering ============
MIN_SCORE=5                  # raise to 8-10 if the bot is too chatty
DEDUP_SIMILARITY=0.72        # 0-1: "same story" threshold between two titles
FEED_FAILURE_THRESHOLD=3     # alert after N cycles with no article from a feed

# ============ Enrichment (free, no key required) ============
ENABLE_KEV=true              # CISA catalog of exploited vulnerabilities
ENABLE_EPSS=true             # 30-day exploitation probability (FIRST.org)
ENRICHMENT_TTL_HOURS=12      # how often the KEV catalog is refreshed
# The two URLs below only need overriding to point at an internal mirror
# or for testing; the defaults are the official sources.
# KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# EPSS_URL=https://api.first.org/data/v1/epss

# ============ AI summarization ============
# gemini | ollama | none
AI_PROVIDER=gemini
GEMINI_API_KEY=paste_your_key_here
# Only Flash / Flash-Lite models are on the free tier.
# Check the exact ID available in Google AI Studio before deploying.
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 models "think" by default, and those tokens are deducted
# from GEMINI_MAX_OUTPUT_TOKENS before any visible text is written — with
# a modest budget this silently truncates every response mid-JSON. Flash
# accepts 0; Pro rejects it (set to false if GEMINI_MODEL is a Pro variant).
GEMINI_DISABLE_THINKING=true
GEMINI_MAX_OUTPUT_TOKENS=1536
AI_DELAY_SECONDS=7           # pause between calls (respects the RPM quota)
AI_MAX_RETRIES=2             # extra attempts on 429 / 5xx
AI_BACKOFF_SECONDS=30        # initial wait, doubled on each retry
# false = defer the article to the next cycle if the quota is exhausted (default)
# true  = publish anyway, with a degraded heuristic summary
DEGRADE_ON_QUOTA=false

# If AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ============ Text retrieval ============
FETCH_FULLTEXT=true
FULLTEXT_MAX_CHARS=4000
HTTP_TIMEOUT=20

# ============ State (no disk writes) ============
# Anti-duplicate window, in days. The index is rebuilt on startup by
# re-reading the Discord channel's history — nothing is stored locally.
RETENTION_DAYS=7
# Cap on messages re-read while priming. 0 = no cap, only the
# RETENTION_DAYS window bounds the read (recommended).
HISTORY_LIMIT=0
FEEDS_FILE=feeds.yaml
