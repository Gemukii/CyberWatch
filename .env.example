# ============ Discord ============
# Token du bot : portail développeur > ton application > Bot > Reset Token
DISCORD_TOKEN=colle_ton_token_ici
# ID du salon de publication (mode développeur > clic droit sur le salon > Copier l'ID)
DISCORD_CHANNEL_ID=123456789012345678
# Optionnel : ID du serveur. Si renseigné, les commandes slash apparaissent
# instantanément. Sinon la synchro est globale (jusqu'à 1 h de propagation).
DISCORD_GUILD_ID=

# ============ Planification ============
# Fréquence de COLLECTE (gratuite : ni IA, ni publication).
INTERVAL_MINUTES=60
MAX_AGE_HOURS=24             # on ignore les articles plus vieux que ça
CANDIDATE_TTL_HOURS=36       # durée de vie d'un candidat en file d'attente
SHORTLIST_LIMIT=15           # articles poussés jusqu'à l'enrichissement par collecte

# ============ Budget quotidien de publication ============
# C'est ici qu'on règle le volume de publication.
# La sélection est RELATIVE : le bot publie les N MEILLEURS du jour, pas ceux
# qui dépassent une barre fixe. Pour être plus sélectif, baisse DAILY_QUOTA —
# ne monte pas le plancher, qui ne sert qu'à écarter le hors-sujet.
DAILY_QUOTA=4                # articles du digest quotidien
DIGEST_MIN_ARTICLES=2        # publiés même une journée calme (0 = silence autorisé)
DIGEST_FLOOR_SCORE=7         # plancher de pertinence, PAS une barre d'excellence
DIGEST_HOUR=8                # heure locale d'envoi du digest
TIMEZONE=Europe/Paris

# ============ Boucle de feedback (votes 👍 / 👎) ============
# Le bot apprend de tes réactions sous les articles publiés. Les poids sont
# recalculés depuis l'historique Discord — rien n'est stocké sur le disque.
# Nécessite la permission "Ajouter des réactions" sur le salon.
ENABLE_FEEDBACK=true
FEEDBACK_LOOKBACK_DAYS=30    # fenêtre glissante des votes pris en compte
FEEDBACK_MIN_VOTES=3         # votes requis sur un signal avant tout ajustement
FEEDBACK_MAX_ADJUSTMENT=4    # ajustement max par signal (borné volontairement)
FEEDBACK_TTL_HOURS=6         # fréquence de relecture de l'historique
FEEDBACK_MESSAGE_LIMIT=500

# ============ Urgences (hors quota, publiées immédiatement) ============
ENABLE_URGENT=true
URGENT_EPSS_THRESHOLD=0.7    # probabilité d'exploitation à 30 jours (0-1)
URGENT_SCORE_THRESHOLD=30    # filet de sécurité pour les sujets sans CVE
URGENT_DAILY_MAX=2           # garde-fou anti-inondation (au-delà, report au digest)
URGENT_MENTION=none          # "none", "here", ou un ID de rôle Discord

# ============ Filtrage ============
MIN_SCORE=5                  # monte à 8-10 si le bot est trop bavard
DEDUP_SIMILARITY=0.72        # 0-1 : seuil de "même sujet" entre deux titres
FEED_FAILURE_THRESHOLD=3     # alerte après N cycles sans article sur un flux

# ============ Enrichissement (gratuit, sans clé) ============
ENABLE_KEV=true              # catalogue CISA des vulnérabilités exploitées
ENABLE_EPSS=true             # probabilité d'exploitation à 30 jours (FIRST.org)
ENRICHMENT_TTL_HOURS=12      # fréquence de rafraîchissement du catalogue KEV
# Les deux URL ci-dessous ne se surchargent que pour pointer vers un miroir
# interne ou pour les tests ; les valeurs par défaut sont les sources officielles.
# KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# EPSS_URL=https://api.first.org/data/v1/epss

# ============ Résumé IA ============
# gemini | ollama | none
AI_PROVIDER=gemini
GEMINI_API_KEY=colle_ta_cle_ici
# Seuls les modèles Flash / Flash-Lite sont sur l'offre gratuite.
# Vérifie l'ID exact disponible dans Google AI Studio avant de déployer.
GEMINI_MODEL=gemini-2.5-flash
AI_DELAY_SECONDS=7           # pause entre deux appels (respect du quota RPM)
AI_MAX_RETRIES=2             # tentatives supplémentaires sur 429 / 5xx
AI_BACKOFF_SECONDS=30        # attente initiale, doublée à chaque tentative
# false = reporter l'article au prochain cycle si le quota est épuisé (défaut)
# true  = publier quand même, avec un résumé heuristique dégradé
DEGRADE_ON_QUOTA=false

# Si AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ============ Récupération du texte ============
FETCH_FULLTEXT=true
FULLTEXT_MAX_CHARS=4000
HTTP_TIMEOUT=20

# ============ État (aucune écriture disque) ============
# Fenêtre anti-doublons, en jours. L'index est reconstruit au démarrage en
# relisant l'historique du salon Discord — rien n'est stocké localement.
RETENTION_DAYS=7
# Plafond de messages relus à l'amorçage. 0 = pas de plafond, seule la
# fenêtre RETENTION_DAYS borne la lecture (recommandé).
HISTORY_LIMIT=0
FEEDS_FILE=feeds.yaml
